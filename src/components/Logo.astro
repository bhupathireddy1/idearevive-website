---
interface Props {
  on?: 'paper' | 'ink';
  class?: string;
}
const { on = 'paper', class: className } = Astro.props;
const ink = on === 'ink';
const base = ink ? '/brand/logo-on-ink' : '/brand/logo';
const size = ink ? { width: 739, height: 281 } : { width: 480, height: 180 };
---
<picture>
  <source srcset={`${base}.webp`} type="image/webp" />
  <img
    class:list={['brand-logo', className]}
    src={`${base}.png`}
    alt="IdeaRevive — Strategic Digital Marketing"
    width={size.width}
    height={size.height}
    loading={ink ? 'lazy' : undefined}
    decoding={ink ? 'async' : undefined}
    fetchpriority={ink ? undefined : 'high'}
  />
</picture>
