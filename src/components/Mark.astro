---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
---
<svg
  class:list={['brand-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
>
  <rect class="brand-mark-plate" width="64" height="64" />
  <circle class="brand-mark-signal" cx="32" cy="22" r="15" />
  <path class="brand-mark-stem" d="M26 35h12l-2 6H28z" />
  <rect class="brand-mark-stem" x="27" y="40" width="10" height="10" />
  <rect class="brand-mark-stem" x="21" y="50" width="22" height="6" />
</svg>
