---
import { getIndustry } from '../data/industries';

interface Props {
  slug: string;
  framed?: boolean;
  class?: string;
}
const { slug, framed = false, class: className } = Astro.props;
const industry = getIndustry(slug);
const label = industry
  ? `Retro print-shop vector for ${industry.name}`
  : 'Retro industry vector';
const uid = `ind-${slug}-${Math.random().toString(36).slice(2, 6)}`;
---
<div class:list={['industry-mark', 'retro', { 'is-framed': framed }, className]} data-kind={slug}>
  <span class="retro-grain" aria-hidden="true"></span>
  <svg viewBox="0 0 400 240" role="img" aria-label={label} preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id={`${uid}-dot`} width="8" height="8" patternUnits="userSpaceOnUse">
        <circle cx="1.2" cy="1.2" r="0.85" fill="#17140f" opacity="0.16" />
      </pattern>
    </defs>
    <rect width="400" height="240" fill="#f7f1e6" />
    <rect width="400" height="240" fill={`url(#${uid}-dot)`} />
    <g class="retro-crop" stroke="#17140f" stroke-width="1.1" fill="none" aria-hidden="true">
      <path d="M12 24 V12 H24 M376 12 H388 V24 M12 216 V228 H24 M376 228 H388 V216" />
    </g>
    <g transform="translate(200 122)">
      <circle class="retro-orbit" r="92" />
      <circle class="retro-orbit retro-orbit-rev" r="68" />
    </g>

    {slug === 'real-estate' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(118 48)">
        <path d="M8 148 V62 L82 18 l74 44 v86" />
        <rect x="28" y="78" width="22" height="28" />
        <rect x="62" y="78" width="22" height="28" />
        <rect x="96" y="78" width="22" height="28" />
        <rect x="28" y="114" width="22" height="34" />
        <rect class="retro-pulse" x="62" y="114" width="22" height="22" fill="#ff4d1a" stroke="none" />
        <rect x="96" y="114" width="22" height="34" />
      </g>
    )}
    {slug === 'healthcare' && (
      <g transform="translate(148 52)" fill="none" stroke="#17140f" stroke-width="2.2">
        <rect x="0" y="20" width="104" height="104" />
        <path d="M52 36 v72 M16 72 h72" stroke-width="14" />
        <rect class="retro-pulse" x="44" y="0" width="16" height="16" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'education' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(96 58)">
        <path d="M104 20 L20 52 v88 L104 148 l84 -32 V52z" />
        <path d="M104 20 v128" />
        <path d="M48 68 v48 M160 68 v48" />
        <rect class="retro-pulse" x="88" y="0" width="32" height="14" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'it-saas' && (
      <g transform="translate(86 50)">
        <g class="retro-sheet" style="--i:0">
          <rect x="0" y="20" width="168" height="112" fill="#fbf8f2" stroke="#17140f" stroke-width="2" />
          <rect x="0" y="20" width="168" height="18" fill="#17140f" />
          <circle cx="14" cy="29" r="4" fill="#ff4d1a" />
        </g>
        <g transform="translate(70 48)"><g class="retro-sheet" style="--i:1">
          <rect width="150" height="100" fill="#fbf8f2" stroke="#17140f" stroke-width="2" />
          <rect width="150" height="18" fill="#17140f" />
          <rect class="retro-pulse" x="16" y="36" width="48" height="46" fill="#ff4d1a" />
          <path d="M76 44 h54 M76 64 h40" stroke="#17140f" stroke-width="2" />
        </g></g>
      </g>
    )}
    {slug === 'ecommerce-retail' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(132 46)">
        <path d="M28 56 l12 -28 h76 l12 28" />
        <path d="M22 56 h92 l-8 88 H30z" />
        <path d="M48 56 v88 M88 56 v88" />
        <rect class="retro-pulse" x="54" y="78" width="28" height="18" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'hospitality' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(118 44)">
        <path d="M8 70 h132 v70 a18 18 0 0 1 -18 18 H26 a18 18 0 0 1 -18 -18z" />
        <path d="M140 78 h18 a16 16 0 0 1 0 32 h-18" />
        <path d="M32 40 v22 M64 28 v34 M96 40 v22" />
        <rect class="retro-pulse" x="58" y="88" width="32" height="12" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'interior-design' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(92 52)">
        <rect x="8" y="8" width="200" height="136" />
        <path d="M40 144 v-36 h136 v36" />
        <path d="M56 108 h104" />
        <rect x="72" y="72" width="72" height="36" />
        <rect class="retro-pulse" x="168" y="24" width="22" height="22" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'landscaping' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(90 56)">
        <path d="M12 132 H208" />
        <path d="M48 132 C48 78 92 48 110 36 C128 48 172 78 172 132" />
        <path d="M110 36 v96" />
        <path d="M28 132 c12 -28 28 -28 40 0" />
        <circle class="retro-pulse" cx="186" cy="48" r="10" fill="#ff4d1a" stroke="#17140f" />
      </g>
    )}
    {slug === 'architecture-construction' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(108 44)">
        <path d="M24 156 V72 L92 28 l68 44 v84" />
        <path d="M8 72 h168" />
        <path d="M40 100 h28 M40 124 h28 M116 100 h28 M116 124 h28" />
        <rect class="retro-pulse" x="80" y="96" width="24" height="24" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'fitness-wellness' && (
      <g fill="none" stroke="#17140f" stroke-width="2.4" transform="translate(86 78)">
        <rect x="0" y="16" width="28" height="52" />
        <rect x="200" y="16" width="28" height="52" />
        <rect x="28" y="28" width="16" height="28" />
        <rect x="184" y="28" width="16" height="28" />
        <path d="M44 42 H184" />
        <rect class="retro-pulse" x="104" y="0" width="20" height="20" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'beauty-salons' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(120 44)">
        <ellipse cx="80" cy="78" rx="54" ry="64" />
        <path d="M26 40 l-18 -22 M134 40 l18 -22" />
        <circle cx="22" cy="12" r="8" />
        <circle cx="138" cy="12" r="8" />
        <rect class="retro-pulse" x="68" y="64" width="24" height="10" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'professional-services' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(124 52)">
        <rect x="8" y="36" width="144" height="96" />
        <path d="M48 36 V20 h56 v16" />
        <path d="M8 64 h144" />
        <rect class="retro-pulse" x="112" y="80" width="22" height="22" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'automotive' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(78 78)">
        <path d="M12 56 h28 l22 -28 h100 l28 28 h36 v36 H12z" />
        <circle cx="64" cy="92" r="16" />
        <circle cx="180" cy="92" r="16" />
        <path d="M12 56 h228" />
        <rect class="retro-pulse" x="118" y="36" width="36" height="16" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'manufacturing' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(146 52)">
        <circle cx="54" cy="68" r="22" />
        <path d="M54 18 v16 M54 102 v16 M10 68 h16 M82 68 h16 M22 36 l12 12 M74 88 l12 12 M22 100 l12 -12 M74 48 l12 -12" />
        <rect class="retro-pulse" x="44" y="58" width="20" height="20" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'jewellery-fashion' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(148 42)">
        <path d="M20 28 h68 l28 40 -62 72 L-14 68z" />
        <path d="M-14 68 h130 M54 140 V68 M20 28 L8 68 M88 28 l12 40" />
        <rect class="retro-pulse" x="42" y="8" width="24" height="12" fill="#ff4d1a" stroke="none" />
      </g>
    )}
    {slug === 'home-services' && (
      <g fill="none" stroke="#17140f" stroke-width="2.1" transform="translate(118 48)">
        <path d="M12 92 L82 28 l70 64" />
        <path d="M28 80 v76 h108 V80" />
        <rect x="68" y="108" width="28" height="48" />
        <path d="M132 128 l28 -28 12 12 -28 28 -8 -4z" />
        <rect class="retro-pulse" x="40" y="100" width="16" height="16" fill="#ff4d1a" stroke="none" />
      </g>
    )}
  </svg>
</div>
